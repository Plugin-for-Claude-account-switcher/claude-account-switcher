{
  "name": "claude-account-switcher",
  "displayName": "Claude Account Switcher",
  "description": "Switch between Claude.ai Pro (session token) and Anthropic API key mode instantly from the VS Code status bar.",
  "version": "0.1.0",
  "publisher": "zayaan-dev",
  "icon": "media/icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "claude",
    "anthropic",
    "ai",
    "chat",
    "switcher",
    "pro",
    "api"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zayaan-dev/claude-account-switcher"
  },
  "homepage": "https://github.com/zayaan-dev/claude-account-switcher#readme",
  "bugs": {
    "url": "https://github.com/zayaan-dev/claude-account-switcher/issues"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "claudeSwitcher.switchMode",
        "title": "Claude: Switch Mode",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "claudeSwitcher.configure",
        "title": "Claude: Configure",
        "icon": "$(gear)"
      },
      {
        "command": "claudeSwitcher.openChat",
        "title": "Claude: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "claudeSwitcher.clearCredentials",
        "title": "Claude: Clear Credentials",
        "icon": "$(trash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeSwitcherContainer",
          "title": "Claude",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "claudeSwitcherContainer": [
        {
          "type": "webview",
          "id": "claudeSwitcher.chatView",
          "name": "Chat"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "claudeSwitcher.switchMode",
          "when": "view == claudeSwitcher.chatView",
          "group": "navigation"
        },
        {
          "command": "claudeSwitcher.configure",
          "when": "view == claudeSwitcher.chatView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Claude Account Switcher",
      "properties": {
        "claudeSwitcher.defaultMode": {
          "type": "string",
          "enum": [
            "api",
            "pro"
          ],
          "enumDescriptions": [
            "Use Anthropic API key",
            "Use Claude.ai Pro session token"
          ],
          "default": "api",
          "description": "Default authentication mode on startup."
        },
        "claudeSwitcher.model": {
          "type": "string",
          "enum": [
            "claude-opus-4-5",
            "claude-sonnet-4-6",
            "claude-haiku-4-5-20251001"
          ],
          "enumDescriptions": [
            "Claude Opus 4.5 — most capable",
            "Claude Sonnet 4.6 — balanced",
            "Claude Haiku 4.5 — fastest"
          ],
          "default": "claude-sonnet-4-6",
          "description": "Model to use in API mode (Pro mode always uses your account default)."
        },
        "claudeSwitcher.maxTokens": {
          "type": "number",
          "default": 4096,
          "minimum": 256,
          "maximum": 8192,
          "description": "Maximum tokens for each response (API mode only)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0"
  }
}
